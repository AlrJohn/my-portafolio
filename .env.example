# Public URL of the separately hosted Raspberry Pi API. Do not include a trailing slash.
VITE_CHAT_API_URL=https://your-chat-api.example.com

# EmailJS browser credentials. These are expected to be public client-side identifiers.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
